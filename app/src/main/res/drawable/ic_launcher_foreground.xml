<?xml version="1.0" encoding="utf-8"?>
<!-- The car of the app's own line icons (CarIcons.Car), drawn big: a 24-unit grid scaled 2.4x into the
     66 dp safe zone of the adaptive icon, with the same round 2-unit strokes as the UI -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="25.2"
        android:translateY="24">
        <!-- cabin -->
        <path
            android:pathData="M5,16V11l2,-5h10l2,5v5"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- body -->
        <path
            android:pathData="M3,16h18v2H3z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- window line -->
        <path
            android:pathData="M5,11h14"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round" />
        <!-- headlights -->
        <path
            android:pathData="M6.9,14a0.6,0.6 0 1 0 1.2,0a0.6,0.6 0 1 0 -1.2,0"
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1" />
        <path
            android:pathData="M15.9,14a0.6,0.6 0 1 0 1.2,0a0.6,0.6 0 1 0 -1.2,0"
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1" />
        <!-- the road, going on: what the launcher is for -->
        <path
            android:pathData="M4,21.5h4M10,21.5h4M16,21.5h4"
            android:strokeColor="#B3FFFFFF"
            android:strokeWidth="1.6"
            android:strokeLineCap="round" />
    </group>
</vector>
