    <string name="problem_channel">Connection problems</string>
    <string name="problem_version_title">The car uses another Android Auto version</string>
    <string name="problem_version_text">The head unit and BetterAuto could not agree on a protocol version. An update of the head unit or of BetterAuto may be needed.</string>
    <string name="problem_certificate_title">The car didn\'t accept BetterAuto</string>
    <string name="problem_certificate_text">This head unit only accepts the official Android Auto: it checks a certificate that only Google can issue, and BetterAuto doesn\'t have one. BetterAuto works with open head units such as Crankshaft.</string>
    <string name="problem_dates_title">The car didn\'t accept the certificate dates</string>
    <string name="problem_dates_text">The head unit says BetterAuto\'s certificate is expired or not valid yet. Check the date and time set in the car.</string>
    <string name="problem_auth_title">The car refused the connection</string>
    <string name="problem_auth_text">The head unit stopped the connection during the security check (code %1$d).</string>
    <string name="problem_not_supported_title">The car doesn\'t support this phone</string>
    <string name="problem_not_supported_text">The head unit closed the connection saying it doesn\'t support this phone or this app right now.</string>
    <string name="problem_device_switch_title">The car switched to another phone</string>
    <string name="problem_device_switch_text">The head unit closed the connection to use another phone. To come back to this one, pick it from the car\'s list of phones.</string>
    <string name="problem_dropped_title">The connection to the car dropped</string>
    <string name="problem_dropped_text">The head unit closed the connection while it was starting, without saying why. Unplug the cable and plug it back in; if it keeps happening, the head unit may not accept BetterAuto.</string>
    <string name="problem_usb_title">Couldn\'t open the USB connection</string>
    <string name="problem_usb_text">Android didn\'t let BetterAuto open the connection the car offered. Unplug the cable and plug it back in.</string>
    <string name="problem_phone_certificate_title">BetterAuto has no usable certificate</string>
    <string name="problem_phone_certificate_text">Among the app\'s certificate files there is no private key with its matching certificate, so the connection can\'t start. The app log says what is missing.</string>
